{
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin",  "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" },
        { "key": "Access-Control-Max-Age",       "value": "86400" }
      ]
    }
  ],
  "functions": {
    "api/gateway.py":              { "maxDuration": 120 },
    "api/generate_design.py":      { "maxDuration": 120 },
    "api/generate_slogans.py":     { "maxDuration": 120 }
  },
  "rewrites": [
    { "source": "/api/webhook/shopify",                "destination": "/api/gateway" },
    { "source": "/api/webhook/shopify/health",         "destination": "/api/gateway" },
    { "source": "/api/dtf/health",                     "destination": "/api/gateway" },
    { "source": "/api/dtf/process",                    "destination": "/api/gateway" },
    { "source": "/api/webhook/order_paid",             "destination": "/api/gateway" },
    { "source": "/api/webhook/order_fulfilled",        "destination": "/api/gateway" },
    { "source": "/api/webhook/order_refunded",         "destination": "/api/gateway" },
    { "source": "/api/webhook/health",                 "destination": "/api/gateway" },
    { "source": "/api/webhook/design-order",           "destination": "/api/gateway" },
    { "source": "/api/webhook/design-order/health",    "destination": "/api/gateway" },
    { "source": "/api/webhook/design-refund",          "destination": "/api/gateway" },
    { "source": "/api/webhook/design-refund/health",   "destination": "/api/gateway" },
    { "source": "/api/designs",                        "destination": "/api/gateway" },
    { "source": "/api/design/process",                 "destination": "/api/gateway" },
    { "source": "/api/design/pipeline/health",         "destination": "/api/gateway" },
    { "source": "/api/design/publish",                 "destination": "/api/gateway" },
    { "source": "/api/design/publish/health",          "destination": "/api/gateway" },
    { "source": "/api/design/feed",                    "destination": "/api/gateway" },
    { "source": "/api/design/feed/health",             "destination": "/api/gateway" },
    { "source": "/api/fulfillment/generate_gang_sheet","destination": "/api/gateway" },
    { "source": "/api/creator/earnings",               "destination": "/api/gateway" },
    { "source": "/api/creator/earnings/summary",       "destination": "/api/gateway" },
    { "source": "/api/creator/earnings/health",        "destination": "/api/gateway" },
    { "source": "/api/creator/(.*)",                   "destination": "/api/gateway" },
    { "source": "/api/ai/slogans",                     "destination": "/api/generate_slogans" },
    { "source": "/api/ai/design-image",                "destination": "/api/generate_design" }
  ]
}
