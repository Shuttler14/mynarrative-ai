{
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin",  "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" },
        { "key": "Access-Control-Max-Age",       "value": "86400" }
      ]
    }
  ],
  "functions": {
    "api/gateway.py":              { "maxDuration": 120 },
    "api/stylist_pipeline.py":     { "maxDuration": 120 },
    "api/virtual_try_on.py":       { "maxDuration": 120 },
    "api/flatlay_extractor.py":    { "maxDuration": 120 },
    "api/marketplace_scraper.py":  { "maxDuration": 120 },
    "api/recommendation_engine.py":{ "maxDuration": 120 },
    "api/user_looks.py":           { "maxDuration": 120 },
    "api/vton_compositor.py":      { "maxDuration": 120 }
  },
  "rewrites": [
    { "source": "/api/webhook/shopify",                "destination": "/api/gateway" },
    { "source": "/api/webhook/shopify/health",         "destination": "/api/gateway" },
    { "source": "/api/dtf/health",                     "destination": "/api/gateway" },
    { "source": "/api/dtf/process",                    "destination": "/api/gateway" },
    { "source": "/api/webhook/order_paid",             "destination": "/api/gateway" },
    { "source": "/api/webhook/order_fulfilled",        "destination": "/api/gateway" },
    { "source": "/api/webhook/order_refunded",         "destination": "/api/gateway" },
    { "source": "/api/webhook/health",                 "destination": "/api/gateway" },
    { "source": "/api/webhook/design-order",           "destination": "/api/gateway" },
    { "source": "/api/webhook/design-order/health",    "destination": "/api/gateway" },
    { "source": "/api/webhook/design-refund",          "destination": "/api/gateway" },
    { "source": "/api/webhook/design-refund/health",   "destination": "/api/gateway" },
    { "source": "/api/designs",                        "destination": "/api/gateway" },
    { "source": "/api/design/process",                 "destination": "/api/gateway" },
    { "source": "/api/design/pipeline/health",         "destination": "/api/gateway" },
    { "source": "/api/design/publish",                 "destination": "/api/gateway" },
    { "source": "/api/design/publish/health",          "destination": "/api/gateway" },
    { "source": "/api/design/feed",                    "destination": "/api/gateway" },
    { "source": "/api/design/feed/health",             "destination": "/api/gateway" },
    { "source": "/api/fulfillment/generate_gang_sheet","destination": "/api/gateway" },
    { "source": "/api/creator/earnings",               "destination": "/api/gateway" },
    { "source": "/api/creator/earnings/summary",       "destination": "/api/gateway" },
    { "source": "/api/creator/earnings/health",        "destination": "/api/gateway" },
    { "source": "/api/creator/(.*)",                   "destination": "/api/gateway" },
    { "source": "/api/classify_item",                  "destination": "/api/gateway" },
    { "source": "/api/cloth_detection",                "destination": "/api/gateway" },
    { "source": "/api/fashion_consultant",             "destination": "/api/gateway" },
    { "source": "/api/generate_design",                "destination": "/api/gateway" },
    { "source": "/api/generate_slogans",               "destination": "/api/gateway" },
    { "source": "/api/physique_analyze",               "destination": "/api/gateway" },
    { "source": "/api/profile_manager",                "destination": "/api/gateway" },
    { "source": "/api/secure_image",                   "destination": "/api/gateway" },
    { "source": "/api/shopify_product",                "destination": "/api/gateway" },
    { "source": "/api/user_profile",                   "destination": "/api/gateway" },
    { "source": "/api/verify_social",                  "destination": "/api/gateway" },
    { "source": "/api/tryon/compose",                  "destination": "/api/vton_compositor" },
    { "source": "/api/tryon/single",                   "destination": "/api/virtual_try_on" },
    { "source": "/api/tryon/full",                     "destination": "/api/virtual_try_on" },
    { "source": "/api/flatlay/extract",                "destination": "/api/flatlay_extractor" },
    { "source": "/api/flatlay/classify",               "destination": "/api/flatlay_extractor" },
    { "source": "/api/marketplace/search",             "destination": "/api/marketplace_scraper" },
    { "source": "/api/marketplace/ingest",             "destination": "/api/marketplace_scraper" },
    { "source": "/api/recommend",                      "destination": "/api/recommendation_engine" },
    { "source": "/api/recommend/:action",              "destination": "/api/recommendation_engine" },
    { "source": "/api/looks",                          "destination": "/api/user_looks" },
    { "source": "/api/looks/:action",                  "destination": "/api/user_looks" }
  ]
}
