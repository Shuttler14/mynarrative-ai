{
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, private" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/cart",                           "destination": "/api/b2b_gateway" },
    { "source": "/api/cart/add",                       "destination": "/api/b2b_gateway" },
    { "source": "/api/cart/update",                    "destination": "/api/b2b_gateway" },
    { "source": "/api/cart/remove",                    "destination": "/api/b2b_gateway" },
    { "source": "/api/cart/clear",                     "destination": "/api/b2b_gateway" },
    { "source": "/api/checkout/create",                "destination": "/api/b2b_gateway" },
    { "source": "/api/checkout/verify",                "destination": "/api/b2b_gateway" },
    { "source": "/api/checkout/address",               "destination": "/api/b2b_gateway" },
    { "source": "/api/orders",                         "destination": "/api/b2b_gateway" },
    { "source": "/api/orders/:path*",                  "destination": "/api/b2b_gateway" },
    { "source": "/api/widget/bootstrap",               "destination": "/api/b2b_gateway" },
    { "source": "/api/widget/event",                   "destination": "/api/b2b_gateway" },
    { "source": "/api/user/identify",                  "destination": "/api/b2b_gateway" },
    { "source": "/api/closet/upload",                  "destination": "/api/b2b_gateway" },
    { "source": "/api/closet/items",                   "destination": "/api/b2b_gateway" },
    { "source": "/api/recommend",                      "destination": "/api/b2b_gateway" },
    { "source": "/api/recommend/eligibility",           "destination": "/api/b2b_gateway" },
    { "source": "/api/recommend/compatibility",         "destination": "/api/b2b_gateway" },
    { "source": "/api/sponsored/pricing",               "destination": "/api/b2b_gateway" },
    { "source": "/api/sponsored/campaigns",             "destination": "/api/b2b_gateway" },
    { "source": "/api/sponsored/campaigns/:path*",      "destination": "/api/b2b_gateway" },
    { "source": "/api/network/event",                   "destination": "/api/b2b_gateway" },
    { "source": "/api/network/report",                  "destination": "/api/b2b_gateway" },
    { "source": "/api/network/product/:path*",          "destination": "/api/b2b_gateway" },
    { "source": "/api/network/partners",                "destination": "/api/b2b_gateway" },
    { "source": "/api/dashboard/overview",              "destination": "/api/b2b_gateway" },
    { "source": "/api/dashboard/products",              "destination": "/api/b2b_gateway" },
    { "source": "/api/dashboard/network-settings",      "destination": "/api/b2b_gateway" },
    { "source": "/api/dashboard/analytics",             "destination": "/api/b2b_gateway" },
    { "source": "/api/dashboard/wallet",                "destination": "/api/b2b_gateway" },
    { "source": "/api/dashboard/wallet/topup",          "destination": "/api/b2b_gateway" },
    { "source": "/api/brand/onboard-shopify",           "destination": "/api/b2b_gateway" },
    { "source": "/api/brand/register-webhooks",         "destination": "/api/b2b_gateway" },
    { "source": "/api/brand/register",                  "destination": "/api/b2b_gateway" },
    { "source": "/api/health",                          "destination": "/api/b2b_gateway" },
    { "source": "/api/brand/search",                    "destination": "/api/brand_search_api" },
    { "source": "/api/brand/search-for-occasion",       "destination": "/api/brand_search_api" },
    { "source": "/api/brand/catalogs",                  "destination": "/api/brand_search_api" },
    { "source": "/api/webhook/order_paid",              "destination": "/api/shopify_webhook" },
    { "source": "/api/webhook/order_fulfilled",         "destination": "/api/shopify_webhook" },
    { "source": "/api/webhook/order_refunded",          "destination": "/api/shopify_webhook" },
    { "source": "/api/webhook/health",                  "destination": "/api/shopify_webhook" },
    { "source": "/api/webhook/design-order",            "destination": "/api/design_order_webhook" },
    { "source": "/api/webhook/design-refund",           "destination": "/api/design_order_webhook" },
    { "source": "/api/designs",                         "destination": "/api/design_feed" },
    { "source": "/api/design/feed",                     "destination": "/api/design_feed" },
    { "source": "/api/design/process",                  "destination": "/api/design_pipeline" },
    { "source": "/api/design/publish",                  "destination": "/api/design_publish" },
    { "source": "/api/creator/(.*)",                    "destination": "/api/creator_economy" },
    { "source": "/api/image/:path*",                    "destination": "/api/image_services" },
    { "source": "/api/fashion/:path*",                  "destination": "/api/fashion_services" },
    { "source": "/api/syndicate/:path*",                "destination": "/api/syndicate/gateway" }
  ]
}
