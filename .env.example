# =====================================================
# MY NARRATIVE - CREATOR ECONOMY SYSTEM
# Production Environment Configuration
# =====================================================

# =====================================================
# SHOPIFY CONFIGURATION
# =====================================================
SHOPIFY_STORE_URL=mynarrative.store
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_token_here
SHOPIFY_ADMIN_ACCESS_TOKEN=your_admin_api_token_here
SHOPIFY_API_VERSION=2024-01

# =====================================================
# SUPABASE (Database & Storage)
# =====================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =====================================================
# OPENAI (GPT-4 for AI Analysis)
# =====================================================
OPENAI_API_KEY=sk-your-openai-key-here

# =====================================================
# REPLICATE (FLUX AI Image Generation)
# =====================================================
REPLICATE_API_TOKEN=your-replicate-token-here

# =====================================================
# AWS REKOGNITION (Image Analysis)
# =====================================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=mynarrative-assets

# =====================================================
# STRIPE CONNECT (Creator Payouts)
# =====================================================
STRIPE_SECRET_KEY=sk_live_your-stripe-secret
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_CONNECT_CLIENT_ID=ca_your-connect-client-id

# =====================================================
# SOCIAL OAUTH (Instagram/YouTube/Twitter)
# =====================================================
# Instagram Basic Display API
INSTAGRAM_CLIENT_ID=your-instagram-client-id
INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret
INSTAGRAM_REDIRECT_URI=https://api.mynarrative.store/oauth/instagram/callback

# YouTube Data API
YOUTUBE_API_KEY=your-youtube-api-key

# Twitter API v2
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_BEARER_TOKEN=your-twitter-bearer-token

# LinkedIn API
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=https://api.mynarrative.store/oauth/linkedin/callback

# =====================================================
# APPLICATION SETTINGS
# =====================================================
APP_URL=https://mynarrative.store
API_URL=https://api.mynarrative.store
FRONTEND_URL=https://mynarrative.store

# Creator Economy Settings
CREATOR_COMMISSION_STANDARD=5
CREATOR_COMMISSION_MICRO=15
CREATOR_COMMISSION_MEGA=50

# Payout Thresholds (INR)
PAYOUT_THRESHOLD_STORE_CREDIT=2500
PAYOUT_THRESHOLD_CASH=5000

# Style Influence Rank Thresholds (Lifetime Earnings INR)
RANK_ROOKIE=0
RANK_EMERGING=10000
RANK_TRENDSETTER=50000
RANK_ARCHITECT=150000
RANK_ICON=500000

# Social Follower Thresholds for Mega Influencer
MEGA_INFLUENCER_INSTAGRAM=500000
MEGA_INFLUENCER_YOUTUBE=250000
MEGA_INFLUENCER_TWITTER=150000
MEGA_INFLUENCER_LINKEDIN=750000

# Feature Flags
ENABLE_CREATOR_DASHBOARD=true
ENABLE_FEATURED_MARKETPLACE=true
ENABLE_CAMPUS_PROGRAM=true
ENABLE_GHOST_MODE=true

# CORS
CORS_ORIGINS=https://mynarrative.store,https://www.mynarrative.store

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Logging
LOG_LEVEL=INFO